DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=streaming_service
DB_USER=streaming_service
DB_PASSWORD=change_me

STREAMING_SOURCE_TYPE=file

STREAMING_SOURCE_DIR=/absolute/path/to/local/video/source
STREAMING_SOURCE_BASENAME=stream_basename

# For local diploma demos without a Holoscan replayer dataset:
# STREAMING_SOURCE_TYPE=mp4
# STREAMING_SOURCE_FILE=/absolute/path/to/sample.mp4

STREAMING_CAMERA_DEVICE=/dev/video0
STREAMING_CAMERA_WIDTH=
STREAMING_CAMERA_HEIGHT=
STREAMING_CAMERA_FRAME_RATE=
STREAMING_CAMERA_PIXEL_FORMAT=
STREAMING_CAMERA_EXPOSURE_TIME=
STREAMING_CAMERA_GAIN=

CLOUD_PUBLISH_ENABLED=0
CLOUD_PUBLISH_REQUIRED=0
BACKEND_API_BASE_URL=http://127.0.0.1:3002
EDGE_DEVICE_ID=edge-dev-001
EDGE_INTERNAL_API_TOKEN=replace-with-shared-token
EDGE_COMMAND_SYNC_ENABLED=1
EDGE_COMMAND_SYNC_POLL_INTERVAL_MS=500
EDGE_DEVICE_STATUS_INTERVAL_MS=5000
EDGE_DEVICE_STATUS_KEEPALIVE_MS=25000
EDGE_SYNC_WS_URL=ws://127.0.0.1:3000/sync
EDGE_SYNC_TOKEN=replace-with-cloud-sync-token
EDGE_SYNC_WS_RECONNECT_MS=3000
CLOUD_PUBLISH_POLL_INTERVAL_MS=100
CLOUD_PUBLISH_FRAME_STALL_TIMEOUT_MS=10000
CLOUD_PUBLISH_LOG_COMMAND_OUTPUT=0
CLOUD_PUBLISH_SHM_SOCKET_PATH=/tmp/streaming-service-publisher.sock
CLOUD_PUBLISH_SHM_SIZE_BYTES=16777216
CLOUD_PUBLISH_FRAME_RATE_NUM=30
CLOUD_PUBLISH_FRAME_RATE_DEN=1

# Direct mediasoup WHIP publishing for the diploma media server.
MEDIA_PUBLISH_WHIP_URL=http://127.0.0.1:3010/whip
MEDIA_PUBLISH_TOKEN=local-publisher-token
MEDIA_PUBLISH_VIEW_URL=http://127.0.0.1:5173
MEDIA_PUBLISH_STREAM_NAME=edge-dev-001
MEDIA_PUBLISH_SESSION_ID=edge-dev-001
MEDIA_PUBLISH_WHIP_CLIENT=
MEDIA_PUBLISH_LOOP_FILE=1

# Optional recording configuration.
STREAMING_RECORD_OUTPUT=
STREAMING_RECORD_OUTPUT_DIR=
STREAMING_RECORD_WIDTH=
STREAMING_RECORD_HEIGHT=
STREAMING_RECORD_FPS=
STREAMING_RECORD_MODE=auto
STREAMING_RECORD_BITRATE_KBPS=8000

# Optional external publisher command scaffold.
# Supported placeholders:
# {session_id} {device_id} {stream_name} {whip_url} {publish_token} {view_url}
# {shm_socket_path} {gst_video_format} {frame_width} {frame_height}
# {frame_rate_num} {frame_rate_den} {keyframe_interval}
# Drop stale whole frames before encoding. Do not use a leaky queue after rtph264pay:
# dropping individual RTP packets corrupts H.264 frames and produces green video.
# MEDIA_PUBLISH_COMMAND_TEMPLATE='/usr/local/bin/whip-client -u "{{WHIP_URL}}" -t "{{PUBLISH_TOKEN}}" -n -l 6 -b 50 -V "shmsrc socket-path={{SHM_SOCKET_PATH}} is-live=true do-timestamp=true ! queue max-size-buffers=1 max-size-bytes=0 max-size-time=0 leaky=downstream ! video/x-raw,format={{GST_VIDEO_FORMAT}},width={{FRAME_WIDTH}},height={{FRAME_HEIGHT}},framerate={{FRAME_RATE_NUM}}/{{FRAME_RATE_DEN}} ! videoconvert ! video/x-raw,format=I420 ! x264enc tune=zerolatency speed-preset=ultrafast bitrate=4000 key-int-max={{KEYFRAME_INTERVAL}} bframes=0 byte-stream=true aud=true sliced-threads=true vbv-buf-capacity=100 rc-lookahead=0 sync-lookahead=0 qos=true ! video/x-h264,profile=constrained-baseline,stream-format=byte-stream,alignment=au ! queue max-size-buffers=1 max-size-bytes=0 max-size-time=0 leaky=downstream ! h264parse config-interval=1 ! rtph264pay pt=96 config-interval=1 mtu=1200 aggregate-mode=zero-latency ! rtprtxqueue max-size-time=2000 max-size-packets=0 ! application/x-rtp,media=video,encoding-name=H264,payload=96,clock-rate=90000"'
